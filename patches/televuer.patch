+    @staticmethod
+    def _tactile_side_index(side_name):
+        side_name = str(side_name).lower()
+        if side_name.startswith("left"):
+            return 0
+        if side_name.startswith("right"):
+            return 1
+        return None
+
+    @staticmethod
+    def _flatten_tactile_view(tactile_view):
+        values = []
+        for item in tactile_view.get("fingers", []):
+            values.extend([
+                float(item.get("heat", 0.0)),
+                float(item.get("normal", 0.0)),
+                float(item.get("tangent", 0.0)),
+                float(item.get("direction_raw", 65535.0)),
+                1.0 if item.get("direction_valid", False) else 0.0,
+            ])
+        for item in tactile_view.get("palm", []):
+            values.extend([
+                float(item.get("heat", 0.0)),
+                float(item.get("normal", 0.0)),
+                float(item.get("tangent", 0.0)),
+                float(item.get("direction_raw", 65535.0)),
+                1.0 if item.get("direction_valid", False) else 0.0,
+            ])
+        while len(values) < TACTILE_SIDE_STRIDE:
+            values.extend([0.0, 0.0, 0.0, 65535.0, 0.0])
+        return values[:TACTILE_SIDE_STRIDE]
+
+    def set_tactile_overlay(self, tactile_view):
+        if tactile_view is None:
+            with self.tactile_overlay_values_shared.get_lock():
+                self.tactile_overlay_values_shared[:] = [0.0] * (TACTILE_SIDE_COUNT * TACTILE_SIDE_STRIDE)
+            with self.tactile_overlay_timestamp_shared.get_lock():
+                now = time.time()
+                for idx in range(TACTILE_SIDE_COUNT):
+                    self.tactile_overlay_timestamp_shared[idx] = now
+            with self.tactile_overlay_enabled_shared.get_lock():
+                self.tactile_overlay_enabled_shared.value = True
+            return
+
+        tactile_views = tactile_view if isinstance(tactile_view, (list, tuple)) else [tactile_view]
+        all_values = [0.0] * (TACTILE_SIDE_COUNT * TACTILE_SIDE_STRIDE)
+        active = [0] * TACTILE_SIDE_COUNT
+        timestamps = [0.0] * TACTILE_SIDE_COUNT
+        now = time.time()
+        for view in tactile_views:
+            if not isinstance(view, dict):
+                continue
+            side_idx = self._tactile_side_index(view.get("side", "right_ee"))
+            if side_idx is None:
+                continue
+            start = side_idx * TACTILE_SIDE_STRIDE
+            all_values[start:start + TACTILE_SIDE_STRIDE] = self._flatten_tactile_view(view)
+            active[side_idx] = 1
+            timestamps[side_idx] = now
+
+        with self.tactile_overlay_active_shared.get_lock():
+            self.tactile_overlay_active_shared[:] = active
+        with self.tactile_overlay_values_shared.get_lock():
+            self.tactile_overlay_values_shared[:] = all_values
+        with self.tactile_overlay_timestamp_shared.get_lock():
+            self.tactile_overlay_timestamp_shared[:] = timestamps
+        with self.tactile_overlay_enabled_shared.get_lock():
+            self.tactile_overlay_enabled_shared.value = True
+
+    def _tactile_hud_snapshots(self):
+        with self.tactile_overlay_enabled_shared.get_lock():
+            enabled = bool(self.tactile_overlay_enabled_shared.value)
+        if not enabled:
+            return []
+        with self.tactile_overlay_active_shared.get_lock():
+            active = list(self.tactile_overlay_active_shared[:])
+        with self.tactile_overlay_timestamp_shared.get_lock():
+            timestamps = list(self.tactile_overlay_timestamp_shared[:])
+        with self.tactile_overlay_values_shared.get_lock():
+            values = np.array(self.tactile_overlay_values_shared[:], dtype=np.float64).reshape(
+                TACTILE_SIDE_COUNT,
+                TACTILE_SITE_COUNT,
+                TACTILE_SITE_STRIDE,
+            )
+        now = time.time()
+        snapshots = []
+        for idx, side in enumerate(TACTILE_SIDE_NAMES):
+            if not active[idx]:
+                continue
+            side_values = values[idx].copy()
+            age = now - float(timestamps[idx]) if timestamps[idx] > 0.0 else 999.0
+            if age > 1.0:
+                side_values[:] = 0.0
+            snapshots.append({"side": side, "age": age, "values": side_values})
+        return snapshots
+
+    @staticmethod
+    def _heat_bgr(heat):
+        heat = float(np.clip(heat, 0.0, 1.0))
+        if heat <= 0.0:
+            return (32, 24, 18)
+        blue = int(230 - 210 * heat)
+        green = int(210 - 130 * heat)
+        red = int(70 + 185 * heat)
+        return (blue, green, red)
+
+    @staticmethod
+    def _fit_text_scale(text, max_width, base_scale=0.42, min_scale=0.25, thickness=1):
+        scale = float(base_scale)
+        while scale > min_scale:
+            width = cv2.getTextSize(text, cv2.FONT_HERSHEY_SIMPLEX, scale, thickness)[0][0]
+            if width <= max_width:
+                return scale
+            scale -= 0.03
+        return min_scale
+
+    def _draw_tactile_hud_panel(self, image, snapshot, x0, y0, width, height):
+        overlay = image.copy()
+        cv2.rectangle(overlay, (x0, y0), (x0 + width, y0 + height), (18, 22, 26), -1)
+        cv2.addWeighted(overlay, 0.74, image, 0.26, 0.0, image)
+        cv2.rectangle(image, (x0, y0), (x0 + width, y0 + height), (70, 82, 92), 1)
+
+        side = snapshot["side"].upper()
+        title = f"RH5DG2 TACTILE {side}"
+        cv2.putText(image, title, (x0 + 10, y0 + 20), cv2.FONT_HERSHEY_SIMPLEX, 0.46, (235, 242, 245), 1, cv2.LINE_AA)
+
+        values = snapshot["values"]
+        max_heat = float(np.max(np.clip(values[:, 0], 0.0, 1.0))) if values.size else 0.0
+        age = snapshot["age"]
+        status = f"{max_heat * 100:03.0f}% {age:.1f}s"
+        status_scale = self._fit_text_scale(status, width - 170, base_scale=0.42)
+        cv2.putText(image, status, (x0 + width - 100, y0 + 20), cv2.FONT_HERSHEY_SIMPLEX, status_scale, (160, 220, 235), 1, cv2.LINE_AA)
+
+        cell_gap = 4
+        cols = 4
+        rows = 2
+        cell_w = max(1, (width - 20 - cell_gap * (cols - 1)) // cols)
+        cell_h = max(1, (height - 36 - cell_gap * (rows - 1)) // rows)
+        start_y = y0 + 30
+        for idx in range(TACTILE_SITE_COUNT):
+            row = idx // cols
+            col = idx % cols
+            x = x0 + 10 + col * (cell_w + cell_gap)
+            y = start_y + row * (cell_h + cell_gap)
+            heat, normal, tangent, direction, direction_valid = values[idx]
+            heat = float(np.clip(heat, 0.0, 1.0))
+            color = self._heat_bgr(heat)
+            cv2.rectangle(image, (x, y), (x + cell_w, y + cell_h), (32, 38, 44), -1)
+            fill_h = int((cell_h - 2) * heat)
+            if fill_h > 0:
+                cv2.rectangle(image, (x + 1, y + cell_h - 1 - fill_h), (x + cell_w - 1, y + cell_h - 1), color, -1)
+            cv2.rectangle(image, (x, y), (x + cell_w, y + cell_h), (84, 96, 106), 1)
+
+            label = TACTILE_SITE_LABELS[idx]
+            cv2.putText(image, label, (x + 4, y + 13), cv2.FONT_HERSHEY_SIMPLEX, 0.35, (245, 248, 250), 1, cv2.LINE_AA)
+            heat_text = f"{heat * 100:.0f}"
+            cv2.putText(image, heat_text, (x + cell_w - 25, y + 13), cv2.FONT_HERSHEY_SIMPLEX, 0.34, (245, 248, 250), 1, cv2.LINE_AA)
+            nt_text = f"N{normal:.0f} T{tangent:.0f}"
+            nt_scale = self._fit_text_scale(nt_text, cell_w - 8, base_scale=0.34, min_scale=0.22)
+            cv2.putText(image, nt_text, (x + 4, y + cell_h - 7), cv2.FONT_HERSHEY_SIMPLEX, nt_scale, (225, 232, 235), 1, cv2.LINE_AA)
+
+            if heat >= 0.03 and tangent > 0.0 and direction_valid > 0.5 and 0.0 <= direction <= 359.0:
+                center = (x + cell_w // 2, y + cell_h // 2 + 2)
+                length = max(8, int(min(cell_w, cell_h) * 0.25))
+                rad = np.deg2rad(direction)
+                end = (
+                    int(center[0] + np.sin(rad) * length),
+                    int(center[1] - np.cos(rad) * length),
+                )
+                cv2.arrowedLine(image, center, end, (235, 195, 80), 1, cv2.LINE_AA, tipLength=0.35)
+
+    def _draw_tactile_hud(self, frame):
+        snapshots = self._tactile_hud_snapshots()
+        if not snapshots or cv2 is None:
+            return frame
+        out = frame.copy()
+        height, width = out.shape[:2]
+        eye_width = self.img_width if self.binocular and width >= self.img_width * 2 else width
+        panel_w = int(np.clip(eye_width * 0.30, 230, 330))
+        panel_h = int(np.clip(height * 0.23, 138, 190))
+        margin = max(12, int(min(eye_width, height) * 0.025))
+        center_gap = max(14, int(eye_width * 0.018))
+        bottom_margin = max(margin, int(height * 0.055))
+        eye_offsets = (0, eye_width) if self.binocular and width >= eye_width * 2 else (0,)
+        for snapshot in snapshots:
+            side = str(snapshot.get("side", "")).lower()
+            for offset in eye_offsets:
+                if side == "left":
+                    x0 = offset + eye_width // 2 - panel_w - center_gap // 2
+                else:
+                    x0 = offset + eye_width // 2 + center_gap // 2
+                x0 = int(np.clip(x0, offset + margin, offset + eye_width - panel_w - margin))
+                y0 = height - panel_h - bottom_margin
+                if x0 >= 0 and y0 >= 0 and x0 + panel_w < width and y0 + panel_h < height:
+                    self._draw_tactile_hud_panel(out, snapshot, x0, y0, panel_w, panel_h)
+        return out
     
