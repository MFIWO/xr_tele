     def _update_frame(self):
         """Return a jepg frame as bytes, and a bgr frame as numpy array"""
         raise NotImplementedError
+
+    # Map friendly config keys -> cv2.CAP_PROP_* ids. Missing props (older OpenCV)
+    # are resolved lazily via getattr and skipped if absent.
+    _OPENCV_CONTROL_NAMES = {
+        "brightness":             "CAP_PROP_BRIGHTNESS",
+        "contrast":               "CAP_PROP_CONTRAST",
+        "saturation":             "CAP_PROP_SATURATION",
+        "hue":                    "CAP_PROP_HUE",
+        "gain":                   "CAP_PROP_GAIN",
+        "gamma":                  "CAP_PROP_GAMMA",
+        "sharpness":              "CAP_PROP_SHARPNESS",
+        "exposure":               "CAP_PROP_EXPOSURE",
+        "auto_exposure":          "CAP_PROP_AUTO_EXPOSURE",
+        "white_balance":          "CAP_PROP_WB_TEMPERATURE",
+        "auto_white_balance":     "CAP_PROP_AUTO_WB",
+        "backlight_compensation": "CAP_PROP_BACKLIGHT",
+    }
+
+    def _apply_opencv_controls(self):
+        """Apply self._controls to an already-opened cv2.VideoCapture (self.cap).
+
+        Controls are applied in config order so dependencies work (e.g. put
+        `auto_exposure: 1` before `exposure: 200` to switch to manual first).
+        Unknown or unsupported controls are logged and skipped, never fatal.
+        """
+        if not self._controls:
+            return
+        for name, value in self._controls.items():
+            prop_name = self._OPENCV_CONTROL_NAMES.get(str(name).lower())
+            if prop_name is None:
+                logger_mp.warning("[%s] unknown control '%s', skipping", self._cam_topic, name)
+                continue
+            prop_id = getattr(cv2, prop_name, None)
+            if prop_id is None:
+                logger_mp.warning("[%s] control '%s' unsupported by this OpenCV build, skipping",
+                                  self._cam_topic, name)
+                continue
+            ok = self.cap.set(prop_id, float(value))
+            actual = self.cap.get(prop_id)
+            if ok:
+                logger_mp.info("[%s] set control %s=%s (readback=%s)",
+                               self._cam_topic, name, value, actual)
+            else:
+                logger_mp.warning("[%s] failed to set control %s=%s (readback=%s)",
+                                  self._cam_topic, name, value, actual)
+
+    def _apply_uvc_controls(self):
+        """Apply self._controls to an already-opened uvc.Capture (self.cap).
+
+        Matches config keys against each control's display name (case- and
+        separator-insensitive), e.g. 'auto_exposure' -> 'Auto Exposure Mode'.
+        """
+        if not self._controls:
+            return
+
+        def _norm(s):
+            return "".join(ch for ch in str(s).lower() if ch.isalnum())
+
+        by_name = {}
+        for ctrl in getattr(self.cap, "controls", []):
+            by_name[_norm(getattr(ctrl, "display_name", ""))] = ctrl
+
+        for name, value in self._controls.items():
+            key = _norm(name)
+            ctrl = by_name.get(key)
+            if ctrl is None:
+                # try a few common aliases
+                aliases = {
+                    "exposure": "absoluteexposuretime",
+                    "autoexposure": "autoexposuremode",
+                    "whitebalance": "whitebalancetemperature",
+                    "autowhitebalance": "whitebalancetemperatureauto",
+                    "backlightcompensation": "backlightcompensation",
+                }
+                ctrl = by_name.get(aliases.get(key, ""))
+            if ctrl is None:
+                logger_mp.warning("[%s] control '%s' not found on device (available: %s), skipping",
+                                  self._cam_topic, name, list(by_name.keys()))
+                continue
+            try:
+                ctrl.value = int(value)
+                logger_mp.info("[%s] set control %s (%s)=%s",
+                               self._cam_topic, name, ctrl.display_name, ctrl.value)
+            except Exception as e:
+                logger_mp.warning("[%s] failed to set control %s=%s: %s",
+                                  self._cam_topic, name, value, e)
+
+    def _scale_for_zmq(self, bgr_numpy):
+        if bgr_numpy is None or abs(self._zmq_scale - 1.0) < 1e-6:
+            return bgr_numpy
+        height, width = bgr_numpy.shape[:2]
+        scaled_width = max(1, int(round(width * self._zmq_scale)))
+        scaled_height = max(1, int(round(height * self._zmq_scale)))
+        return cv2.resize(bgr_numpy, (scaled_width, scaled_height), interpolation=cv2.INTER_AREA)
+
+    def _encode_zmq_jpeg(self, bgr_numpy, encode_params=None):
+        zmq_frame = self._scale_for_zmq(bgr_numpy)
