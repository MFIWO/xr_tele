+class RemoteZMQCamera(BaseCamera):
+    """Camera source backed by Host PUSH -> robot PULL ZMQ frames."""
+
+    def __init__(
+        self,
+        cam_topic,
+        bind_addr,
+        img_shape,
+        fps,
+        enable_zmq=True,
+        zmq_port=55555,
+        enable_webrtc=False,
+        webrtc_port=66666,
+        webrtc_codec=None,
+        recv_timeout_ms=1000,
+        stale_timeout_ms=1000,
+        jpeg_quality=95,
+        zmq_scale=1.0,
+    ):
+        super().__init__(cam_topic, img_shape, fps, enable_zmq, zmq_port, enable_webrtc, webrtc_port, webrtc_codec, zmq_scale=zmq_scale)
+        self._bind_addr = bind_addr
+        self._recv_timeout_ms = int(recv_timeout_ms)
+        self._stale_timeout_ms = int(stale_timeout_ms)
+        self._jpeg_quality = int(jpeg_quality)
+        self._context = zmq.Context.instance()
+        self._socket = self._context.socket(zmq.PULL)
+        self._socket.setsockopt(zmq.RCVHWM, 1)
+        self._socket.setsockopt(zmq.LINGER, 0)
+        self._socket.bind(self._bind_addr)
+        self._lock = threading.Lock()
+        self._running = True
+        self._latest_frame = None
+        self._latest_jpeg = None
+        self._latest_meta = {}
+        self._latest_rx_ns = 0
+        self._last_receive_log = 0.0
+        self._last_timeout_log = 0.0
+        self._recv_thread = threading.Thread(target=self._recv_loop, daemon=True)
+        self._recv_thread.start()
+        self._ready.set()
+        logger_mp.info(str(self))
+        logger_mp.info("[RemoteZMQCamera] bind %s camera=%s", self._bind_addr, self._cam_topic)
+
+    def __str__(self):
+        return (
+            f"[RemoteZMQCamera: {self._cam_topic}] initialized with "
+            f"{self._img_shape[0]}x{self._img_shape[1]} @ {self._fps} FPS, bind={self._bind_addr}.\n"
+            f"ZMQ: {'enabled, zmq port=' + str(self._zmq_port) if self._enable_zmq else 'disabled'}; "
+            f"WebRTC: {'enabled, webrtc port=' + str(self._webrtc_port) if self._enable_webrtc else 'disabled'}"
+        )
+
+    def _recv_loop(self):
+        poller = zmq.Poller()
+        poller.register(self._socket, zmq.POLLIN)
+        while self._running:
+            try:
+                events = dict(poller.poll(timeout=self._recv_timeout_ms))
+                if self._socket not in events:
+                    self._log_timeout()
+                    continue
+
+                parts = self._socket.recv_multipart(flags=zmq.NOBLOCK)
+                meta, payload = self._parse_message(parts)
+                frame, jpeg_bytes = self._decode_payload(meta, payload)
+                if frame is None:
+                    continue
+
+                with self._lock:
+                    self._latest_frame = frame
+                    self._latest_jpeg = jpeg_bytes
+                    self._latest_meta = meta
+                    self._latest_rx_ns = time.time_ns()
+
+                self._log_receive(meta, frame)
+            except zmq.Again:
+                continue
+            except Exception as e:
+                if self._running:
+                    logger_mp.warning("[RemoteZMQCamera] receive error camera=%s: %s", self._cam_topic, e)
+
+    def _parse_message(self, parts):
+        if len(parts) == 1:
+            return {"camera_name": self._cam_topic, "encoding": "jpg"}, parts[0]
+
+        try:
+            meta = json.loads(parts[0].decode("utf-8"))
+        except Exception as e:
+            logger_mp.warning("[RemoteZMQCamera] invalid metadata camera=%s: %s", self._cam_topic, e)
+            meta = {"camera_name": self._cam_topic, "encoding": "jpg"}
+        return meta, parts[-1]
+
+    def _decode_payload(self, meta, payload):
+        encoding = str(meta.get("encoding", "jpg")).lower()
+        if encoding in ("jpg", "jpeg"):
+            jpg = bytes(payload)
+            frame = cv2.imdecode(np.frombuffer(jpg, dtype=np.uint8), cv2.IMREAD_COLOR)
+            if frame is None:
+                logger_mp.warning("[RemoteZMQCamera] JPEG decode failed camera=%s", self._cam_topic)
+            return frame, jpg
+
+        if encoding == "bgr8":
+            height = int(meta.get("height", self._img_shape[0]))
+            width = int(meta.get("width", self._img_shape[1]))
+            expected = height * width * 3
+            if len(payload) != expected:
+                logger_mp.warning(
+                    "[RemoteZMQCamera] bgr8 payload size mismatch camera=%s expected=%s actual=%s",
+                    self._cam_topic,
+                    expected,
+                    len(payload),
+                )
+                return None, None
+            frame = np.frombuffer(payload, dtype=np.uint8).reshape((height, width, 3)).copy()
+            return frame, self._encode_zmq_jpeg(frame, [int(cv2.IMWRITE_JPEG_QUALITY), self._jpeg_quality])
+
+        logger_mp.warning("[RemoteZMQCamera] unsupported encoding camera=%s encoding=%s", self._cam_topic, encoding)
+        return None, None
+
+    def _log_receive(self, meta, frame):
+        now = time.monotonic()
+        if now - self._last_receive_log < 1.0:
+            return
+        self._last_receive_log = now
+        timestamp_ns = int(meta.get("timestamp_ns", 0) or 0)
+        latency_ms = ((time.time_ns() - timestamp_ns) / 1_000_000.0) if timestamp_ns > 0 else -1.0
+        logger_mp.info(
+            "[RemoteZMQCamera] received %s shape=%s latency_ms=%.2f seq=%s",
+            meta.get("camera_name", self._cam_topic),
+            frame.shape,
+            latency_ms,
+            meta.get("frame_id", meta.get("seq", None)),
+        )
+
+    def _log_timeout(self):
+        now = time.monotonic()
+        if now - self._last_timeout_log < max(1.0, self._recv_timeout_ms / 1000.0):
+            return
+        self._last_timeout_log = now
+        age_ms = None
+        with self._lock:
+            if self._latest_rx_ns:
+                age_ms = (time.time_ns() - self._latest_rx_ns) / 1_000_000.0
+        if age_ms is None or age_ms >= self._stale_timeout_ms:
+            logger_mp.warning(
+                "[RemoteZMQCamera] timeout no frame for %s ms camera=%s bind=%s",
+                "unknown" if age_ms is None else f"{age_ms:.0f}",
+                self._cam_topic,
+                self._bind_addr,
+            )
+
+    def _update_frame(self):
+        with self._lock:
+            bgr_numpy = None if self._latest_frame is None else self._latest_frame.copy()
+            jpeg_bytes = self._latest_jpeg
+
+        if bgr_numpy is None:
+            return
+
+        if self._enable_webrtc:
+            self._webrtc_buffer.write(bgr_numpy)
+
+        if self._enable_zmq:
+            if abs(self._zmq_scale - 1.0) >= 1e-6:
+                jpeg_bytes = self._encode_zmq_jpeg(bgr_numpy, [int(cv2.IMWRITE_JPEG_QUALITY), self._jpeg_quality])
+            elif jpeg_bytes is None:
+                jpeg_bytes = self._encode_zmq_jpeg(bgr_numpy, [int(cv2.IMWRITE_JPEG_QUALITY), self._jpeg_quality])
+            if jpeg_bytes is not None:
+                self._zmq_buffer.write(jpeg_bytes)
+
+    def release(self):
+        self._running = False
+        if self._recv_thread.is_alive():
+            self._recv_thread.join(timeout=1.0)
+        try:
+            self._socket.close()
+        except Exception as e:
+            logger_mp.warning("[RemoteZMQCamera] socket close failed camera=%s: %s", self._cam_topic, e)
+        logger_mp.info("[RemoteZMQCamera] Released %s", self._cam_topic)
