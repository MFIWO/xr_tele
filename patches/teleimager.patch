+# PC4 teleimager server config:
+# - head camera is opened locally on PC4.
+# - wrist cameras are received from Host NUC over ZMQ and republished as normal teleimager streams.
+
+head_camera:
+  enable_zmq: true
+  zmq_port: 55555
+  enable_webrtc: true
+  webrtc_port: 60001
+  webrtc_codec: h264
+  type: opencv
+  image_shape: [376, 1344]
+  # Downscale only the ZMQ/JPEG stream used by recording; WebRTC keeps the original frame.
+  zmq_scale: 0.5
+  binocular: true
+  fps: 30
+  video_id: 0
+  serial_number: null
+  physical_path: null
+
+left_wrist_camera:
+  enable_zmq: true
+  zmq_port: 55556
+  enable_webrtc: false
+  webrtc_port: 60002
+  webrtc_codec: h264
+  type: remote_zmq
+  remote_bind: "tcp://0.0.0.0:55602"
+  image_shape: [480, 640]
+  binocular: false
+  fps: 30
+  remote_timeout_ms: 1000
+  remote_stale_timeout_ms: 1000
+
+right_wrist_camera:
+  enable_zmq: true
+  zmq_port: 55557
+  enable_webrtc: false
+  webrtc_port: 60003
+  webrtc_codec: h264
+  type: remote_zmq
+  remote_bind: "tcp://0.0.0.0:55604"
+  image_shape: [480, 640]
+  binocular: false
+  fps: 30
+  remote_timeout_ms: 1000
+  remote_stale_timeout_ms: 1000
